#!/bin/bash
# boot is what every task and scheduled job starts with (Nick 2026-11-22: ensure quality for boot): a commit touching it
# must pass the offline boot test. Enabled by `git config core.hooksPath .githooks` (set once per clone).
if git diff --cached --name-only | grep -qE '^scripts/(boot\.sh|boot_state\.py|boot_test\.sh|stabilize\.py|flow\.py)$'; then
  scripts/boot_test.sh || { echo "pre-commit: boot_test failed - not committing"; exit 1; }
fi
